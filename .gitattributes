# Gradle wrapper 必须是 LF，否则 Linux runner 上 `./gradlew` 会报
# "bad interpreter: /bin/sh^M: no such file or directory"
gradlew text eol=lf

# CI 里直接 python3 执行的脚本同理
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows 与 Android Studio 的默认
*.bat text eol=crlf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf

# 二进制
*.jar binary
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
